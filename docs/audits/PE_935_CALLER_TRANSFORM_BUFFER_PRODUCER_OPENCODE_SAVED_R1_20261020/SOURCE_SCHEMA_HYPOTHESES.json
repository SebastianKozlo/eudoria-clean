{
  "hypotheses": [
    {
      "id": "H_ROT_X",
      "statement": "13 words = 3x3 rotation-about-X + 3 + 1: layout [[1,0,0],[0,H1(c),H2(c)],[0,-H2(c),H1(c)]] with i12=1.0 (scale-like).",
      "status": "PLAUSIBLE",
      "basis": "store-level structure CONFIRMED (i0=1.0, i1..i3=0, i6=0, i7=-i5-source, i8=i4-source, i12=1.0); H1/H2 are opaque CRT import helpers - cos/sin identity NOT established."
    },
    {
      "id": "H_NITRANSFORM",
      "statement": "buffer is a NiTransform-like record (rotation 3x3, translation 3, scale 1).",
      "status": "PLAUSIBLE_NOT_ESTABLISHED",
      "basis": "9+3+1 with scale-like 1.0 fits; but i9/i10 are ASYMMETRIC raw copies ([EBX+0] and [EBX+0x10]) and i11 is a hardcoded 0 - weak for a translation vector; world-space role NOT established."
    },
    {
      "id": "H_AABB_DERIVED",
      "statement": "i9/i10 come from a bounding-box-like object: EBX fields read at +0,+4,+0xC,+0x10 with subtractions ([EBX+0xC]-[EBX] @85A25B, [EBX+0x10]-[EBX+4] @85A293) feeding ftol products.",
      "status": "PLAUSIBLE",
      "basis": "offset pattern matches min/max pairs; class of EBX object UNKNOWN."
    },
    {
      "id": "H_PADDING",
      "statement": "i9..i12 are padding/scratch.",
      "status": "REJECTED_WITHIN_PROVEN_PREMISES",
      "basis": "all four have explicit value-producing writers (field copies, zero, 1.0), not uninitialized."
    }
  ],
  "float_note": "i0..i8,i12 are provably float-stored values; i9/i10 are raw dword MOV copies (bit-preserving float round-trips), i11 is raw zero. No world-space or unit semantics derivable from the listing.",
