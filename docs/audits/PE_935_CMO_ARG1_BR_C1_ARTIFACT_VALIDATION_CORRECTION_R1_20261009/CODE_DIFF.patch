+# ---------------- BR-C1 persisted-fact field helpers (correction
+# PE_935_CMO_ARG1_BR_C1_ARTIFACT_VALIDATION_CORRECTION_R1_20261009)
+#
+# Small, targeted field-reading/type/expression comparison helpers for the four
+# BR-C1 relations ONLY. Not a general schema engine; never eval. Every helper
+# returns (ok, diagnostic, value) and never raises for a missing field, a
+# wrong native JSON type, a malformed supported expression or a mismatch.
+
+def field_get(container, dotted):
+    """Read a dotted field path from nested dicts. Returns (present, value)."""
+    cur = container
+    for part in dotted.split("."):
+        if type(cur) is not dict or part not in cur:
+            return False, None
+        cur = cur[part]
+    return True, cur
+
+
+def _tname(v):
+    return type(v).__name__
+
+
+def check_str(container, dotted, expected):
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not str:
+        return False, ("WRONG_TYPE:%s:expected JSON string, got %s"
+                       % (dotted, _tname(v))), v
+    if v != expected:
+        return False, ("VALUE_MISMATCH:%s:derived %r, got %r"
+                       % (dotted, expected, v)), v
+    return True, "OK", v
+
+
+def check_int(container, dotted, expected):
+    """Native JSON integer comparison. JSON booleans are NOT integers here
+    (type(True) is bool in Python), so a boolean is rejected as WRONG_TYPE."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not int:
+        return False, ("WRONG_TYPE:%s:expected JSON integer, got %s"
+                       % (dotted, _tname(v))), v
+    if v != expected:
+        return False, ("VALUE_MISMATCH:%s:derived %d, got %r"
+                       % (dotted, expected, v)), v
+    return True, "OK", v
+
+
+def check_bool(container, dotted, expected):
+    """Native JSON boolean comparison; no string->boolean coercion (JSON
+    false is not a valid positive bridge predicate)."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not bool:
+        return False, ("WRONG_TYPE:%s:expected JSON boolean, got %s"
+                       % (dotted, _tname(v))), v
+    if v is not expected:
+        return False, ("VALUE_MISMATCH:%s:derived %r, got %r"
+                       % (dotted, expected, v)), v
+    return True, "OK", v
+
+
+def check_va_str(container, dotted, derived_va):
+    """Persisted VA string form '0x%08X' compared to a derived VA."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not str:
+        return False, ("WRONG_TYPE:%s:expected JSON string, got %s"
+                       % (dotted, _tname(v))), v
+    m = re.match(r"^0x([0-9a-fA-F]{8})$", v)
+    if not m:
+        return False, ("MALFORMED_EXPR:%s:not a supported 0xXXXXXXXX VA "
+                       "string" % dotted), v
+    if int(m.group(1), 16) != derived_va:
+        return False, ("VALUE_MISMATCH:%s:derived %s, got %r"
+                       % (dotted, va_str(derived_va), v)), v
+    return True, "OK", v
+
+
+def check_slot_expr(container, dotted, base, derived_delta):
+    """Persisted '[T-0x10]' style slot expression vs the derived delta."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not str:
+        return False, ("WRONG_TYPE:%s:expected JSON string, got %s"
+                       % (dotted, _tname(v))), v
+    if not re.match(r"^\[%s(?:[+-]0x[0-9a-fA-F]+)?\]$" % re.escape(base), v):
+        return False, ("MALFORMED_EXPR:%s:not a supported [%s+0x..] slot "
+                       "expression" % (dotted, base)), v
+    if v != slot_expr(base, derived_delta):
+        return False, ("VALUE_MISMATCH:%s:derived %s, got %r"
+                       % (dotted, slot_expr(base, derived_delta), v)), v
+    return True, "OK", v
+
+
+def check_addr_expr(container, dotted, derived_delta):
+    """Persisted 'ADDRESS(T+0x8)' style pointer-value expression vs the
+    derived LEA result delta."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not str:
+        return False, ("WRONG_TYPE:%s:expected JSON string, got %s"
+                       % (dotted, _tname(v))), v
+    m = re.match(r"^ADDRESS\(T(?:([+-])0x([0-9a-fA-F]+))?\)$", v)
+    if not m:
+        return False, ("MALFORMED_EXPR:%s:not a supported ADDRESS(T+0x..) "
+                       "expression" % dotted), v
+    got = 0
+    if m.group(1):
+        got = int(m.group(2), 16)
+        if m.group(1) == "-":
+            got = -got
+    if got != derived_delta:
+        return False, ("VALUE_MISMATCH:%s:derived ADDRESS(T%s0x%x), got %r"
+                       % (dotted, "+" if derived_delta >= 0 else "-",
+                          abs(derived_delta), v)), v
+    return True, "OK", v
+
+
+def check_arg_slot_expr(container, dotted, derived_delta):
+    """Persisted arg_slots documented finite form 'T0+0x8 (computed)' vs the
+    derived delta (the ' (computed)' suffix is explicitly normalized)."""
+    present, v = field_get(container, dotted)
+    if not present:
+        return False, "MISSING_FIELD:" + dotted, None
+    if type(v) is not str:
+        return False, ("WRONG_TYPE:%s:expected JSON string, got %s"
+                       % (dotted, _tname(v))), v
+    m = re.match(r"^T0(?:([+-])0x([0-9a-fA-F]+))?(?: \(computed\))?$", v)
+    if not m:
+        return False, ("MALFORMED_EXPR:%s:not a supported T0+0x.. "
+                       "(computed) expression" % dotted), v
+    got = 0
+    if m.group(1):
+        got = int(m.group(2), 16)
+        if m.group(1) == "-":
+            got = -got
+    if got != derived_delta:
+        return False, ("VALUE_MISMATCH:%s:derived T0%s0x%x, got %r"
+                       % (dotted, "+" if derived_delta >= 0 else "-",
+                          abs(derived_delta), v)), v
+    return True, "OK", v
+
